# Copie para .env.local e preencha.

# Nome que aparece no app
NEXT_PUBLIC_APP_NAME=PlacaLink

# Endereço público do app (vai gravado nos QR Codes e chips NFC — não mude depois de imprimir!)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave SECRETA (sb_secret_...). Necessária para a loja: cria pedidos e confirma pagamentos.
# Nunca compartilhe nem coloque em código que vai para o navegador.
SUPABASE_SECRET_KEY=

# Mercado Pago → Suas integrações → Credenciais (use as de TESTE primeiro)
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: segredo do webhook (Suas integrações → Webhooks) para validar a assinatura
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio → Configurações → Tokens (sem token, usa o frete fixo abaixo)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_EMAIL=seu@email.com
SHIPPING_ORIGIN_CEP=01001000
# Frete fixo em centavos, usado enquanto não há token do Melhor Envio
SHIPPING_FIXED_CENTS=2500

# Resend (e-mails de pedido). Sem chave, os e-mails só aparecem no log do servidor.
RESEND_API_KEY=
EMAIL_FROM=PlacaLink <pedidos@seudominio.com.br>

# Google Places API (New): gerador de link, acompanhamento de avaliações e busca de clientes
GOOGLE_PLACES_API_KEY=
# Buscas de prospecção por usuário por dia (cada busca = 1 consulta; 1.000 grátis/mês no total)
PLACES_DAILY_SEARCHES=15
# Atualizar a nota de cada cliente a cada N dias (7 dias ≈ 230 clientes dentro do grátis)
GOOGLE_REFRESH_DAYS=7
GOOGLE_REFRESH_MAX_PER_RUN=100
# Segredo da rota diária /api/cron/google (a Vercel envia automaticamente se definido lá)
CRON_SECRET=
